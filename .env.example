# ==============================================================================
# Residencial Anhanduí - Configurações de Ambiente (Modelo)
# Copie este arquivo para .env na raiz do projeto e ajuste conforme necessário.
# O arquivo .env local é ignorado pelo Git para segurança.
# ==============================================================================

# Porta do Servidor Web Local
PORT=8080

# Caminho do Banco de Dados SQLite (Arquivo Local Único)
CONDO_DB_PATH=data/condominio.db

# Caminho de Armazenamento dos Documentos e Recibos Físicos Digitalizados
CONDO_STORAGE_PATH=data/documentos

# Perfil de Execução Spring Boot
SPRING_PROFILES_ACTIVE=default
